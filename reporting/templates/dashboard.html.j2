<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Monitoring Dashboard — {{ model.name }}</title>
{% if plotlyjs %}{{ plotlyjs | safe }}{% endif %}
<style>
  :root { --ink:#1f2933; --muted:#6b7280; --line:#e4e7eb;
          --green:#1b8a4b; --amber:#d99100; --red:#c0392b; }
  * { box-sizing: border-box; }
  body { margin:0; background:#eef1f5; color:var(--ink);
         font:14px/1.5 -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; }
  header { background:#12263a; color:#fff; padding:16px 24px; display:flex;
           flex-wrap:wrap; gap:12px; align-items:center; justify-content:space-between; }
  header h1 { font-size:18px; margin:0; }
  header .meta { color:#b9c6d6; font-size:12.5px; }
  .wrap { max-width:1200px; margin:0 auto; padding:20px 24px 48px; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
  .tile { background:#fff; border:1px solid var(--line); border-radius:10px; padding:12px 14px; min-width:0; }
  .tile .k { color:var(--muted); font-size:12px; }
  .tile .v { font-size:24px; font-weight:700; }
  .tile .s { font-size:11px; font-weight:700; text-transform:uppercase; color:#fff; padding:1px 8px; border-radius:999px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(420px,1fr)); gap:16px; }
  .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:8px 12px 14px; min-width:0; overflow:hidden; }
  .card.span { grid-column:1 / -1; }
  table { width:100%; border-collapse:collapse; font-size:12.5px; }
  th,td { padding:6px 9px; border-bottom:1px solid var(--line); text-align:left; }
  th { background:#f0f3f7; position:sticky; top:0; }
  td.num { text-align:right; font-variant-numeric:tabular-nums; }
  .pill { font-size:10.5px; font-weight:700; text-transform:uppercase; padding:1px 7px; border-radius:999px; color:#fff; }
  .pill.green{background:var(--green);} .pill.amber{background:var(--amber);} .pill.red{background:var(--red);}
  .scroll { max-height:340px; overflow:auto; }
  .cf-chart { width:100%; height:auto; }
  .hint { color:var(--muted); font-size:12px; margin:4px 0 0; }
</style>
</head>
<body>
<header>
  <div>
    <h1>{{ model.name }} — monitoring dashboard</h1>
    <div class="meta">version {{ model.version }} · generated {{ generated_at }} · {{ n_periods }} periods</div>
  </div>
  <div class="meta">
    {% if is_interactive %}Interactive (Plotly) — hover, zoom, toggle legend series.{% else %}Static fallback (Plotly not installed).{% endif %}
  </div>
</header>
<div class="wrap">
  <div class="tiles">
    <div class="tile" style="border-left:5px solid {{ latest_color }}">
      <div class="k">Overall status · {{ latest.period }}</div>
      <div class="v" style="color:{{ latest_color }}">{{ (latest.rag_overall or 'n/a') | upper }}</div>
    </div>
    <div class="tile"><div class="k">PSI</div><div class="v">{{ '%.4f' % latest.psi if latest.psi is not none else '—' }}</div></div>
    <div class="tile"><div class="k">Gini</div><div class="v">{{ '%.4f' % latest.gini if latest.gini is not none else '—' }}</div></div>
    <div class="tile"><div class="k">KS</div><div class="v">{{ '%.4f' % latest.ks if latest.ks is not none else '—' }}</div></div>
    <div class="tile"><div class="k">Calibration gap</div><div class="v">{{ '%.4f' % latest.calibration_gap if latest.calibration_gap is not none else '—' }}</div></div>
    <div class="tile"><div class="k">Breaches (all periods)</div><div class="v">{{ breaches | length }}</div></div>
  </div>

  <div class="grid">
    <div class="card"><div id="c-psi">{{ charts.psi_trend | safe }}</div></div>
    <div class="card"><div id="c-disc">{{ charts.discrimination_trend | safe }}</div></div>
    <div class="card span"><div id="c-csi">{{ charts.csi_heatmap | safe }}</div></div>
    <div class="card"><div id="c-calib">{{ charts.calibration | safe }}</div></div>
    <div class="card scroll">
      <table>
        <thead><tr><th>Period</th><th class="num">PSI</th><th class="num">Gini</th><th class="num">KS</th><th>Status</th></tr></thead>
        <tbody>
        {% for row in fact_rows %}
        <tr>
          <td>{{ row.period }}</td>
          <td class="num">{{ '%.4f' % row.psi if row.psi is not none else '—' }}</td>
          <td class="num">{{ '%.4f' % row.gini if row.gini is not none else '—' }}</td>
          <td class="num">{{ '%.4f' % row.ks if row.ks is not none else '—' }}</td>
          <td>{% if row.rag_overall %}<span class="pill {{ row.rag_overall }}">{{ row.rag_overall }}</span>{% endif %}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  <p class="hint">Fallback dashboard generated by <code>reporting.dashboard</code>. Build the Tableau
  version by following <code>docs/reporting/TABLEAU_DASHBOARD.md</code>.</p>
</div>
</body>
</html>
