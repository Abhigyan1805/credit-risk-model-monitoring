<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Model Monitoring Report — {{ model.name }} — {{ latest_period }}</title>
{% if plotlyjs %}{{ plotlyjs | safe }}{% endif %}
<style>
  :root {
    --ink: #1f2933; --muted: #6b7280; --line: #e4e7eb; --bg: #ffffff;
    --green: #1b8a4b; --amber: #d99100; --red: #c0392b;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: #f4f6f8; color: var(--ink);
         font: 14px/1.5 -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; }
  .page { max-width: 1080px; margin: 0 auto; background: var(--bg); padding: 32px 40px 64px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 32px 0 12px; border-bottom: 2px solid var(--line); padding-bottom: 6px; }
  .sub { color: var(--muted); margin: 0 0 20px; }
  .banner { display: flex; align-items: center; gap: 16px; padding: 18px 20px;
            border-radius: 10px; color: #fff; margin: 16px 0 24px; }
  .banner .dot { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,0.85); flex: none; }
  .banner .status { font-size: 22px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .banner .status-detail { opacity: 0.95; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .kpi { border: 1px solid var(--line); border-left: 5px solid var(--muted); border-radius: 8px; padding: 12px 14px; background: #fcfdff; min-width: 0; }
  .kpi .label { color: var(--muted); font-size: 12px; min-height: 30px; }
  .kpi .value { font-size: 22px; font-weight: 700; margin-top: 4px; }
  .kpi .tag { display: inline-block; margin-top: 6px; font-size: 11px; font-weight: 700;
              text-transform: uppercase; padding: 1px 8px; border-radius: 999px; color: #fff; }
  .chart-card { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px 12px; margin: 12px 0; overflow: hidden; }
  .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 8px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); }
  th { background: #f0f3f7; position: sticky; top: 0; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .pill { font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 1px 8px; border-radius: 999px; color: #fff; }
  .pill.green { background: var(--green); } .pill.amber { background: var(--amber); } .pill.red { background: var(--red); }
  .muted { color: var(--muted); }
  .breach-red td:first-child { border-left: 4px solid var(--red); }
  .breach-amber td:first-child { border-left: 4px solid var(--amber); }
  .note { background: #f8fafc; border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; color: var(--muted); font-size: 12.5px; }
  .cf-chart { width: 100%; height: auto; }
  @media print { body { background: #fff; } .page { padding: 0; } .chart-card { break-inside: avoid; } }
</style>
</head>
<body>
<div class="page">
  <h1>Model Monitoring Report</h1>
  <p class="sub">
    <strong>{{ model.name }}</strong> · version {{ model.version }} · target: {{ model.target }}<br>
    Monitoring period: <strong>{{ latest_period }}</strong> · reference period {{ model.reference_period }} ·
    generated {{ generated_at }}
  </p>

  {% set status = overall_status or 'unknown' %}
  <div class="banner" style="background: {{ overall_color }}">
    <span class="dot"></span>
    <div>
      <div class="status">Overall status: {{ status }}</div>
      <div class="status-detail">
        {% if status == 'green' %}All monitored metrics within tolerance for {{ latest_period }}.
        {% elif status == 'amber' %}One or more metrics deteriorating — review required for {{ latest_period }}.
        {% elif status == 'red' %}One or more metrics breached red thresholds — action required for {{ latest_period }}.
        {% else %}Status could not be determined from the available metrics.{% endif %}
      </div>
    </div>
  </div>

  <h2>1 · Executive summary — headline metrics ({{ latest_period }})</h2>
  <div class="kpis">
    {% for kpi in kpis %}
    <div class="kpi" style="border-left-color: {{ kpi.color }}">
      <div class="label">{{ kpi.label }}</div>
      <div class="value">{{ kpi.value }}</div>
      {% if kpi.status %}<span class="tag" style="background: {{ kpi.color }}">{{ kpi.status }}</span>{% endif %}
    </div>
    {% endfor %}
  </div>
  <p class="note">
    <strong>RAG rules.</strong>
    PSI / CSI: green &lt; 0.10, amber 0.10–0.25, red ≥ 0.25.
    AUC / Gini / KS: amber if &gt; 0.02 below, red if &gt; 0.05 below the reference value.
    Calibration gap (mean |predicted − observed|): amber &gt; 0.02, red &gt; 0.05.
    Overall status is the worst status across all metrics.
    Population observed in {{ latest_period }}: {{ latest_fact.n_obs }} accounts, default rate {{ latest_fact.default_rate }}.
  </p>

  <h2>2 · Stability — population and characteristic drift (PSI / CSI)</h2>
  <div class="chart-card">{{ charts.psi_trend | safe }}</div>

  <h2>3 · Discrimination — Gini / KS over time</h2>
  <div class="chart-card">{{ charts.discrimination_trend | safe }}</div>

  <h2>4 · Calibration by score band ({{ latest_period }})</h2>
  <div class="grid-2">
    <div class="chart-card">{{ charts.calibration | safe }}</div>
    <div>
      <table>
        <thead><tr><th>Band</th><th class="num">Count</th><th class="num">Predicted PD</th>
        <th class="num">Observed PD</th><th class="num">Abs gap</th><th>RAG</th></tr></thead>
        <tbody>
        {% for row in calibration_rows %}
          <tr>
            <td>{{ row.band }}</td>
            <td class="num">{{ row.count }}</td>
            <td class="num">{{ '%.4f' % row.predicted_pd if row.predicted_pd is not none else '—' }}</td>
            <td class="num">{{ '%.4f' % row.observed_pd if row.observed_pd is not none else '—' }}</td>
            <td class="num">{{ '%.4f' % row.abs_gap if row.abs_gap is not none else '—' }}</td>
            <td>{% if row.rag_calibration %}<span class="pill {{ row.rag_calibration }}">{{ row.rag_calibration }}</span>{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <h2>5 · Feature stability heat-map (CSI)</h2>
  <div class="chart-card">{{ charts.csi_heatmap | safe }}</div>

  <h2>6 · Breaches ({{ breaches | length }} across all periods)</h2>
  {% if breaches %}
  <table>
    <thead><tr><th>Period</th><th>Metric</th><th class="num">Value</th><th class="num">Reference</th><th>Level</th><th>Detail</th></tr></thead>
    <tbody>
    {% for b in breaches %}
      <tr class="breach-{{ b.level }}">
        <td>{{ b.period }}</td>
        <td>{{ b.metric }}</td>
        <td class="num">{{ '%.4f' % b.value if b.value is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % b.reference if b.reference is not none else '—' }}</td>
        <td><span class="pill {{ b.level }}">{{ b.level }}</span></td>
        <td>{{ b.message }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="muted">No breaches recorded.</p>
  {% endif %}

  <h2>7 · Full monthly metrics (all {{ n_periods }} periods)</h2>
  <table>
    <thead><tr>
      <th>Period</th><th class="num">N</th><th class="num">Default rate</th>
      <th class="num">PSI</th><th class="num">CSI</th><th class="num">AUC</th>
      <th class="num">Gini</th><th class="num">KS</th><th class="num">Calib. gap</th><th>Overall</th>
    </tr></thead>
    <tbody>
    {% for row in fact_rows %}
      <tr>
        <td>{{ row.period }}</td>
        <td class="num">{{ row.n_obs }}</td>
        <td class="num">{{ '%.4f' % row.default_rate if row.default_rate is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % row.psi if row.psi is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % row.csi if row.csi is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % row.auc if row.auc is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % row.gini if row.gini is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % row.ks if row.ks is not none else '—' }}</td>
        <td class="num">{{ '%.4f' % row.calibration_gap if row.calibration_gap is not none else '—' }}</td>
        <td>{% if row.rag_overall %}<span class="pill {{ row.rag_overall }}">{{ row.rag_overall }}</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <p class="note" style="margin-top:24px">
    Generated automatically by the credit-risk model monitoring pipeline.
    This report is regenerated on every monitoring run; all values come from the
    monitoring-results document for the run. See
    <code>docs/reporting/REPORTING.md</code> for how it is produced.
  </p>
</div>
</body>
</html>
